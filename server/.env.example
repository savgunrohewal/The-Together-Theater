# Copy this file to .env and fill in your own values.

# MongoDB connection string. Use a free MongoDB Atlas cluster, or a local
# mongod instance (mongodb://localhost:27017/watch-party).
# If left unset, the server still runs, but chat history and room
# records won't persist across restarts.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/watch-party

# Port the Express + Socket.IO server listens on
PORT=5000

# Origin allowed to connect (your Vite dev server / deployed frontend URL)
CLIENT_ORIGIN=http://localhost:5173
